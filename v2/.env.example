# SimpleFIN Bridge — https://bridge.simplefin.org ($15/yr)
# After signup, you'll get a one-time "setup token" (base64 URL).
# Paste it into the /link page in the app; the access URL gets stored in the DB.
# No env var needed for SimpleFIN credentials.

# LLM for chat
OPENAI_API_KEY=

# Local SQLite file (created on first run)
DATABASE_URL=./budget.db
